# Environment variables template for Docker Compose
# Copy this file to .env and update the values as needed

# Database Configuration
DB_PASSWORD=enterprise_pass_change_me
POSTGRES_DB=enterprise_db
POSTGRES_USER=enterprise_user

# Redis Configuration
REDIS_PASSWORD=redis_pass_change_me

# Application Configuration
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_change_me_minimum_256_bits
JWT_EXPIRATION=86400

# File Upload Configuration
FILE_UPLOAD_MAX_SIZE=10MB
FILE_UPLOAD_PATH=/app/uploads

# Logging Configuration
LOGGING_LEVEL_COM_ENTERPRISE=DEBUG
LOGGING_LEVEL_ROOT=INFO

# External Service URLs (for production)
# EXTERNAL_API_BASE_URL=https://api.external-service.com
# NOTIFICATION_SERVICE_URL=https://notifications.example.com

# Monitoring Configuration
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info,metrics,prometheus
MANAGEMENT_ENDPOINT_HEALTH_SHOW_DETAILS=when_authorized

# Cache Configuration
SPRING_CACHE_TYPE=redis
SPRING_CACHE_REDIS_TIME_TO_LIVE=3600

# Batch Job Configuration
SPRING_BATCH_JOB_ENABLED=true
SPRING_BATCH_INITIALIZE_SCHEMA=always

# Security Configuration
SECURITY_REQUIRE_SSL=false
SECURITY_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Performance Configuration
SPRING_JPA_SHOW_SQL=false
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=20
SPRING_DATASOURCE_HIKARI_MINIMUM_IDLE=5